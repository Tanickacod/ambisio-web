{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "biela", "name": "Biela", "color": "#FFFFFF" },
        { "slug": "piesok", "name": "Piesková", "color": "#EAE4D9" },
        { "slug": "piesok-svetly", "name": "Piesková svetlá", "color": "#F6F2EB" },
        { "slug": "hneda", "name": "Hnedá", "color": "#8A6E52" },
        { "slug": "tmava", "name": "Tmavá", "color": "#1D1B18" },
        { "slug": "seda", "name": "Sivá text", "color": "#6B665E" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "'Manrope', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/manrope.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Malé", "size": "0.85rem" },
        { "slug": "medium", "name": "Základné", "size": "1rem" },
        { "slug": "large", "name": "Veľké", "size": "1.35rem" },
        { "slug": "x-large", "name": "Nadpis", "size": "clamp(1.6rem, 3vw, 2.4rem)" },
        { "slug": "xx-large", "name": "Hero nadpis", "size": "clamp(2.1rem, 4.6vw, 3.6rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "12px" },
        { "slug": "30", "name": "S", "size": "24px" },
        { "slug": "40", "name": "M", "size": "48px" },
        { "slug": "50", "name": "L", "size": "clamp(56px, 9vw, 120px)" }
      ]
    },
    "custom": {
      "radius": "2px",
      "line": "#DFD8CC",
      "warm": "#B3AA99"
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--biela)", "text": "var(--wp--preset--color--tmava)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": { "typography": { "fontWeight": "800", "lineHeight": "1.15" } },
      "link": { "color": { "text": "var(--wp--preset--color--hneda)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--tmava)", "text": "var(--wp--preset--color--biela)" },
        "typography": { "fontWeight": "700", "fontSize": "0.8rem", "letterSpacing": "0.16em", "textTransform": "uppercase" },
        "border": { "radius": "2px" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Hlavička", "area": "header" },
    { "name": "footer", "title": "Pätička", "area": "footer" }
  ]
}
